# Docker Compose の公開先。LAN へ公開するときは 0.0.0.0 に変更。
HANAFUDA_HOST=127.0.0.1
HANAFUDA_PORT=3000
RUST_LOG=info
# Host と Origin が異なるリバースプロキシ構成の場合だけ指定。
# ALLOWED_ORIGIN=https://hanafuda.example.com

# Rust サーバーを直接起動するときの環境変数。
# .env は Rust サーバーから自動読込されません。シェルで export してください。
# BIND_ADDR=0.0.0.0:3000
# STATIC_DIR=client/dist
